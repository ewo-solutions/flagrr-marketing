# This marketing site never talks to Payfast directly — the Flagrr app's own
# backend owns the Payfast merchant account, the checkout, and the club/admin
# database. This site only calls that backend to start a signup, then hands
# the browser off to Payfast's hosted payment page.

# The Flagrr app backend's base URL (holds the Payfast integration + DB).
# Defaults to the deployed app if unset.
FLAGRR_APP_URL=https://flagrr-loyalty.vercel.app

# This site's own public URL. MUST be a real https:// address for the club
# signup flow to work — Payfast (and the app backend's own validation) flatly
# reject non-https return/cancel URLs. Leave unset for local development;
# set it once this site is deployed.
SITE_URL=https://your-domain.example

# Google Analytics 4 measurement ID (starts with "G-"). Optional — leave unset
# to disable analytics entirely (local dev and any preview deploy should stay
# unset). NEXT_PUBLIC_ because it's read in the browser. Note: GA sets cookies,
# and this site doesn't yet have a privacy policy or a cookie-consent banner —
# see README's "Legal" note — so treat setting this in production as blocked
# on those landing first.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
